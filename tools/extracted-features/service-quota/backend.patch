 	InvalidateAPIKeyRateLimit(ctx context.Context, keyID int64) error
 }
 
+// BillingCache 计费服务的完整缓存接口（3 个关注点的组合）。
+// 保留该聚合接口是为了兼容现有消费者（如 *BillingCacheService）；新代码应尽量依赖
+// 更窄的子接口（BalanceCache / SubscriptionCache / RateLimitCache）。
