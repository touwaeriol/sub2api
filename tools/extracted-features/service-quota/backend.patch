+	limiter := newFakeLimiter()
+	rule := ruleConcurrencyAccount(6, 7, 5)
+	repo := newMockSettingRepo()
+	svc := newQuotaServiceForTest(t, []*ServiceQuotaRule{rule}, repo, limiter)
+
+	ticket := &BillingTicket{
