+func TestSnapshot_EmptyResult_OK(t *testing.T) {
+	spy := &spyMonitorSvc{
+		resp: &service.MonitorSnapshot{Enabled: true, Items: []service.LimiterRuntime{}},
+	}
+	r, rec := setupMonitorHandler(spy)
+	req := httptest.NewRequest(http.MethodGet, "/monitor", nil)
+	r.ServeHTTP(rec, req)
