+func (s *SettingService) GetFloat(ctx context.Context, key string) (float64, error) {
+	value, err := s.settingRepo.GetValue(ctx, key)
+	if err != nil {
+		if errors.Is(err, ErrSettingNotFound) {
+			return 0, nil
+		}
+		return 0, err
+	}
+	v, convErr := strconv.ParseFloat(value, 64)
+	if convErr != nil {
+		return 0, nil
+	}
+	return v, nil
+}
