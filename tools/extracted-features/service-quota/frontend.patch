+    expect(table.text()).toContain('rows=1')
+    expect(table.text()).toContain('ids=1')
+    wrapper.unmount()
+  })
+
+  it('限额范围 scope=mine 仅保留 counter_mode=user 行', async () => {
+    getMyServiceQuotaMock.mockResolvedValueOnce(
