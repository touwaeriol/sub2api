+  it('limiterTypes chip 多选过滤（≥2 种类型时显示 chip）', async () => {
+    getMyServiceQuotaMock.mockResolvedValueOnce(
+      makeSnapshot({
+        items: [
+          makeRow({ rule_id: 1, limiter_type: 'rpm' }),
